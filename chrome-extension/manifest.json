{
  "manifest_version": 3,
  "name": "YNeet – NEET Countdown & Daily Question",
  "short_name": "YNeet NEET",
  "version": "1.0.0",
  "description": "Every new tab: days left to NEET, this week's study target and a new NEET question every day. Free, by YNeet.",
  "homepage_url": "https://www.yneet.in",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["search"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.yneet.in"
  }
}
