# ===== Server =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== MongoDB =====
# Local: mongodb://127.0.0.1:27017/raise-academy
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/raise-academy
MONGO_URI=mongodb://127.0.0.1:27017/raise-academy

# ===== JWT =====
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== Email (Nodemailer) — used for OTP + password reset =====
# Gmail: use a 16-character Google "App Password", not your normal password.
# https://myaccount.google.com/apppasswords
# Gmail SMTP (family:4 forced in code to avoid IPv6 hangs on cloud hosts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="YNeet <your_email@gmail.com>"

# ===== YNeet SSO integration =====
# MUST match JWT_SECRET/INTERNAL_SERVICE_KEY set in the YNeet backend's .env — this is
# how the two apps trust each other without a shared database.
INTERNAL_SERVICE_KEY=replace_this_with_a_long_random_string

# ===== Admin bootstrap =====
# Used once by scripts/createAdmin.js to create the first admin login.
ADMIN_EMAIL=raiseacademy999@gmail.com
ADMIN_PASSWORD=change_me_immediately
